#
# Secondo fragment del percorso mainline, applicato DOPO
# linux-mainline.config e solo da lyra_plus_mainline_defconfig.
#
# Contiene una sola cosa: la cmdline con la root su flash. Tutto il resto
# (pruning delle piattaforme, sottosistemi, SPI NAND) e' identico fra le due
# varianti mainline e sta nel fragment condiviso.
#
# L'ordine conta e Buildroot lo preserva: BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES
# finisce in LINUX_KCONFIG_FRAGMENT_FILES (linux.mk:377) e da li' nella riga di
# comando di merge_config.sh (pkg-kconfig.mk:67, invocato con -m e senza -s).
# merge_config.sh cancella il valore precedente e appende il nuovo
# (merge_config.sh:153-166), quindi l'ultimo file vince, e stampa
#     Value of CONFIG_CMDLINE is redefined by fragment ...
# Quel warning e' il comportamento atteso: senza -s non e' un errore.
#
# ---------------------------------------------------------------------------
# Perche' l'intera stringa e' duplicata
# ---------------------------------------------------------------------------
# CONFIG_CMDLINE e' un simbolo string: Kconfig non ha modo di appendere a un
# valore esistente, quindi per aggiungere il root= va riscritto tutto. Le due
# copie vanno tenute allineate a mano: la parte fino a `mtdparts=...` deve
# essere identica a quella di linux-mainline.config, dove sta anche la
# spiegazione di ogni pezzo (earlycon, console, clk_ignore_unused, mtdparts e
# il perche' dell'mtd-id "spi0.0").
#
# L'alternativa - CMDLINE_EXTEND, per lasciare che U-Boot passi il root= -
# non funziona: U-Boot genera un mtdparts con mtd-id "spi-nand0", che su
# mainline non combacia con nessun MTD (vedi linux-mainline.config sezione
# 1/6). Serve la nostra cmdline in entrambe le varianti.
#
# ---------------------------------------------------------------------------
# I tre parametri aggiunti
# ---------------------------------------------------------------------------
#   ubi.mtd=rootfs
#       attacca UBI alla partizione MTD chiamata "rootfs". Per NOME, non per
#       indice: ubi_mtd_param_parse prova prima simple_strtoul e, se la
#       stringa non e' un numero, chiama get_mtd_device_nm()
#       (drivers/mtd/ubi/build.c:1216-1225). Cosi' se il layout di
#       parameter.txt cambia ordine, questa riga resta valida.
#   root=ubi0:rootfs
#       il volume dentro quel device UBI. Il nome "rootfs" e' quello che
#       scrive ubinize: vol_name=rootfs in buildroot/fs/ubi/ubinize.cfg:5.
#   rootfstype=ubifs
#       UBIFS non e' auto-rilevabile da un root= (non c'e' un blockdev da
#       cui leggere un superblocco), quindi va detto.
#   rw
#       il percorso vendor monta la root in scrittura; senza questo il
#       primo boot fallirebbe a scrivere /etc/random-seed e i file di
#       /var/run.
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0xff0a0000 console=ttyS0,1500000 clk_ignore_unused rootwait mtdparts=spi0.0:0x400000@0x400000(uboot),0xc00000@0x800000(boot),0xdf60000@0x2000000(rootfs) ubi.mtd=rootfs root=ubi0:rootfs rootfstype=ubifs rw"
CONFIG_CMDLINE_FORCE=y
