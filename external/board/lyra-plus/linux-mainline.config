#
# Fragment applicato sopra arch/arm/configs/multi_v7_defconfig
# (kernel mainline 6.19.0, repo rk3506-kernel-upstream, SHA 8f714b51).
# Usato SOLO da lyra_plus_mainline_initramfs_defconfig. Il percorso vendor
# continua a usare linux.config sopra rk3506_luckfox_defconfig.
#
# ---------------------------------------------------------------------------
# DUPLICAZIONE DICHIARATA
# ---------------------------------------------------------------------------
# Le righe da "ARCH_MULTI_V7" a "MTD is not set" sono la copia di
# arch/arm/configs/rk3506_minimal.config del repo kernel (commit e2072af1,
# ritoccato da 8f714b51). NON e' un caso di copia-incolla evitabile:
#
#   BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES vuole percorsi risolvibili
#   sull'HOST quando Buildroot valuta le variabili, cioe' prima che il
#   kernel sia stato scaricato. arch/arm/configs/rk3506_minimal.config
#   esiste solo dentro $(LINUX_DIR), che nasce dopo. Puntarci darebbe
#   "No such file or directory" al momento del merge.
#
# Conseguenza: se il fragment in-tree cambia, questo va riallineato a mano.
# Il confronto e' un diff secco:
#   diff -u <kernel>/arch/arm/configs/rk3506_minimal.config \
#           external/board/lyra-plus/linux-mainline.config
# (le differenze attese sono solo le sei sezioni marcate "AGGIUNTO QUI").

CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ROCKCHIP=y

# Clock and reset controller. CLK_RK3506 is "default y" and depends on
# "ARM || COMPILE_TEST" (drivers/clk/rockchip/Kconfig:103), so it would be
# picked up anyway; listed here to pin the intent.
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK3506=y

# Pin control and GPIO. Built in, not modular: the uart0 pinmux has to be
# applied before the console can be opened.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ROCKCHIP=y

# Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y

# Timer, interrupt controller, PSCI (secondary CPU bring-up and reset)
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_GIC=y
CONFIG_ARM_PSCI=y
CONFIG_ARM_PSCI_FW=y

# ramoops: the only way to read a panic that happened before the console was
# up. Backed by reserved-memory ramoops@83000 in rk3506.dtsi.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Rootfs from initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Explicitly out of scope for a console-only bring-up: no node in the DT
# drives any of these, and each one is a probe that could run before the
# console is live.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set

# ---------------------------------------------------------------------------
# AGGIUNTO QUI (1/6): bootargs dal kernel, non dal DTS
# ---------------------------------------------------------------------------
# Il DTS in-tree rk3506g-luckfox-lyra-plus.dts:14-16 ha solo `stdout-path`,
# non `bootargs`; il DTS custom vendor invece se li portava dietro in
# /chosen. CMDLINE_FORCE toglie del tutto U-Boot dall'equazione: qualunque
# cosa passi in ATAG/FDT viene ignorata.
#
# Serve in bring-up per un motivo diagnostico preciso: se la board resta
# muta, la cmdline non e' fra i sospetti. A prompt ottenuto si puo'
# rilassare (togliere CMDLINE_FORCE, o passare a CMDLINE_EXTEND) e
# ricominciare a leggere i bootargs da U-Boot.
#
#   earlycon=uart8250,mmio32,0xff0a0000
#       stampa prima che il driver 8250 abbia fatto probe, quindi prima
#       che serva clock o pinctrl. Indirizzo di uart0 da
#       rk3506.dtsi:146 (serial@ff0a0000), lo stesso di
#       CONFIG_DEBUG_UART_BASE in U-Boot (vedi uboot.config:10).
#       mmio32 perche' il nodo dichiara reg-io-width = <4>.
#   console=ttyS0,1500000
#       ttyS0, NON ttyFIQ0: il fiq-debugger Rockchip
#       (CONFIG_FIQ_DEBUGGER) non esiste in mainline. 1500000 e' esatto
#       con entrambi i parent possibili di sclk_uart0
#       (clk_frac_uart_matrix0 a 96 MHz: 96e6/(16*1500000) = 4;
#       xin24m a 24 MHz: divisore 1) - clk-rk3506.c:123,418.
#   clk_ignore_unused
#       il dtsi minimale (305 righe) descrive uart0, GIC, timer e poco
#       altro: tutti gli altri clock risultano "unused" e il clock
#       framework li spegnerebbe a fine boot. Fra questi c'e' quello che
#       tiene su la UART se il bootloader l'ha lasciata su un parent che
#       nessun nodo reclama.
#   rootwait
#       innocuo con initramfs, ma tenuto per non dover cambiare cmdline
#       quando questo defconfig crescera' verso una root su storage.
#   mtdparts=spi0.0:...
#       le partizioni MTD devono arrivare dalla NOSTRA cmdline, non da
#       quella di U-Boot, e non e' solo per CMDLINE_FORCE. U-Boot genera
#       a runtime `mtdparts=spi-nand0:<size>@<off>(<name>)` in byte
#       (mtd_blk.c:410-426, il `<< 9` converte i settori in byte) e
#       cmdlinepart accetta la definizione solo se l'mtd-id combacia
#       esattamente con mtd->name (cmdlinepart.c:332,346). Ma:
#         - il kernel vendor forza mtd->name = "spi-nand0" con una patch
#           locale Rockchip (rk3506-kernel core.c:1408-1409, dentro
#           `if (IS_ENABLED(CONFIG_SPI_ROCKCHIP_SFC))`);
#         - mainline non ha quella patch: spinand non assegna mtd->name
#           (core.c:1672,1678 registra con name NULL) e mtdcore ricade su
#           dev_name(parent) = nome del device SPI (mtdcore.c:896-897),
#           cioe' "spi0.0".
#       Quindi la stringa di U-Boot non combacia mai su mainline, ne'
#       combacia il CMDLINE: di parameter.txt (mtd-id vuoto, e comunque
#       in settori). Va scritta qui con mtd-id "spi0.0" e in byte.
#       Il layout e' quello di board/lyra-plus/parameter.txt:12,
#       convertito settori -> byte come fa post-image.sh:318:
#         uboot   0x00002000@0x00002000  ->  0x400000@0x400000     4 MiB @  4 MiB
#         boot    0x00006000@0x00004000  ->  0xc00000@0x800000    12 MiB @  8 MiB
#         rootfs  -@0x00010000           ->  0xdf60000@0x2000000  1787 blocchi
#
#       La rootfs NON puo' essere "-" (SIZE_REMAINING), e questa e' la
#       trappola: "-" significa "fino alla fine del DISPOSITIVO", mentre la
#       partizione finisce prima. La GPT reale sulla scheda, letta con
#       `upgrade_tool PL`, dice
#           03  0x00010000  0x0006fbdf  rootfs
#       cioe' 457695 settori = 1787.87 blocchi di erase: l'ultimo LBA e'
#       523230, 1058 settori prima della fine del chip, perche' li' c'e' la
#       GPT di backup. Con "-" la nostra mtd2 sarebbe di 1792 blocchi e
#       includerebbe i blocchi 1787-1791, che NON appartengono alla
#       partizione. Il tool di flash non li tocca - correttamente - ma UBI ci
#       cresce dentro e ci scrive header EC, e al riflash successivo restano
#       con l'image sequence number vecchio:
#           ubi0 error: ubi_attach: bad image sequence number ... in PEB 1790
#       cioe' kernel panic su root fs, con l'unico rimedio di un `upgrade_tool
#       ef` prima di ogni `uf`.
#
#       0xdf60000 = 1787 blocchi e' esattamente il valore che U-Boot calcola
#       per la partizione con tag `grow` (mtd_blk.c:449-461):
#           size = info.size - (info.size - 1) % (erasesize >> 9) - 1
#           457695 - 222 - 1 = 457472 settori = 1787 blocchi
#       Quindi la nostra mtd2 coincide con quella che riceve il kernel
#       vendor, dove il riflash con `uf` da solo ha sempre funzionato.
#
#       Se parameter.txt o la dimensione della flash cambiano, questa riga va
#       ricalcolata con quella formula sui valori di `upgrade_tool PL`: sono
#       due dichiarazioni dello stesso layout e nessuno le confronta.
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0xff0a0000 console=ttyS0,1500000 clk_ignore_unused rootwait mtdparts=spi0.0:0x400000@0x400000(uboot),0xc00000@0x800000(boot),0xdf60000@0x2000000(rootfs)"
CONFIG_CMDLINE_FORCE=y

# ---------------------------------------------------------------------------
# AGGIUNTO QUI (2/6): via le piattaforme ARM che non sono questa
# ---------------------------------------------------------------------------
# multi_v7_defconfig e' un defconfig MULTI-piattaforma: accende 76 famiglie di
# SoC ARMv7, di cui RK3506 e' una. Il risultato non entra nella partizione
# `boot` di questa board:
#
#     zImage  15.07 MiB  ->  boot.img  15.09 MiB  /  boot = 12.00 MiB   NO
#
# e non e' un problema di rootfs: l'initramfs e' gia' compresso dentro il
# kernel (CONFIG_INITRAMFS_COMPRESSION_GZIP), e `Image` non compresso e'
# 34.90 MiB. Il solo kernel compresso e' ~13 MiB, quindi non ci starebbe
# nemmeno con un rootfs vuoto.
#
# Misurato su questo albero, con la toolchain di Buildroot. Tutte le misure di
# zImage sono CON l'initramfs incorporato, perche' e' quello che finisce in
# boot.img: Buildroot ricompila il kernel dopo aver generato rootfs.cpio
# (">>>   Rebuilding kernel with initramfs").
#
#     multi_v7 cosi' com'e'                       zImage  15.07 MiB   boot.img 15.09  NO
#     + queste 72 piattaforme spente              zImage  12.11 MiB   boot.img ~12.13 NO
#     + i sottosistemi della sezione (3/6)        zImage   6.30 MiB   boot.img  6.32  OK
#     + i 41 SOC_* (chiude il buco OMAP)          zImage   6.16 MiB   boot.img  6.18  OK
#
# L'ultima riga e' la configurazione attuale.
#
# Per riferimento: il kernel senza initramfs e' ~4.0 MiB, e lo zImage del
# percorso vendor 6.1 e' 4.19 MiB. Un kernel mainline sfoltito e uno vendor
# sono quindi della stessa taglia; e' multi_v7 non sfoltito a essere fuori
# scala, perche' e' un defconfig per 76 famiglie di SoC.
#
# La riga di mezzo e' la ragione per cui esiste anche la sezione (3/6):
# spegnere le sole piattaforme lascia 0.13 MiB sopra il limite. Quella misura
# viene da un esperimento incrementale (sed sul .config gia' risolto +
# olddefconfig), non da un merge pulito, quindi va letta come ordine di
# grandezza: il punto e' che non bastava.
#
# La lista NON e' scritta a mano: viene dai Kconfig del kernel, intersecando i
# simboli di piattaforma con quelli che multi_v7_defconfig accende, meno
# Rockchip e meno l'infrastruttura multi-piattaforma
# (ARCH_MULTI*, ARCH_VIRT). Per rigenerarla dopo un aggiornamento del kernel:
#
#   cd <kernel>
#   grep -hE '^(menu)?config (ARCH|SOC)_' arch/arm/Kconfig.platforms arch/arm/mach-*/Kconfig \
#     | sed 's/^\(menu\)\?config //' | sort -u > /tmp/psyms
#   make ARCH=arm multi_v7_defconfig >/dev/null
#   grep -E '^CONFIG_(ARCH|SOC)_[A-Z0-9_]+=y' .config | sed 's/^CONFIG_//; s/=y$//' \
#     | sort > /tmp/pen
#   comm -12 /tmp/psyms /tmp/pen \
#     | grep -viE 'rockchip|rk3[0-9]|^ARCH_MULTI|^ARCH_VIRT$'
#
# Devono entrarci sia i simboli ARCH_* sia i SOC_*, e non e' un dettaglio:
# SOC_AM33XX, SOC_AM43XX, SOC_DRA7XX e SOC_OMAP5 fanno `select ARCH_OMAP2PLUS`
# (arch/arm/mach-omap2/Kconfig), quindi spegnere i soli ARCH_OMAP* non basta:
# OMAP rientra e resta compilato dentro. Verificato su questo albero -- con la
# sola lista ARCH_* il .config finale aveva ancora ARCH_OMAP=y e ARCH_OMAP2PLUS=y.
#
# ATTENZIONE: se mainline aggiunge una piattaforma nuova, quella NON e' in
# questa lista e rientra dalla finestra, facendo ricrescere lo zImage. Il
# controllo che se ne accorge e' la verifica dimensioni di post-image.sh, che
# fallisce la build invece di produrre un'immagine non flashabile.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AT91 is not set
