# ---------------------------------------------------------------------------
# AGGIUNTO QUI (3/6): sottosistemi fuori scope per una console seriale
# ---------------------------------------------------------------------------
# Le sei righe della sezione ereditata da rk3506_minimal.config (DRM, FB,
# SOUND, USB_SUPPORT, MMC, MTD) non bastano a rientrare nei 12 MiB: dopo il
# pruning delle piattaforme siamo a 12.11 MiB, cioe' 0.13 MiB sopra. Queste
# spengono il resto di cio' che nessun nodo del dtsi minimale reclama.
#
# Stesso criterio dichiarato da rk3506_minimal.config: "Anything that is not
# needed to print on uart0 is turned off on purpose, so that no driver can
# fail to probe before the console is up." Qui e' applicato fino in fondo,
# perche' qui c'e' anche un vincolo di dimensione che in-tree non c'era.
#
# Conseguenza da conoscere: NESSUNA RETE. Non e' un effetto collaterale
# nascosto, e' la scelta: questa immagine si usa dalla seriale. Per questo il
# defconfig toglie anche BR2_PACKAGE_IFUPDOWN_SCRIPTS, che altrimenti
# installerebbe un S40network destinato a fallire a ogni boot sporcando la
# console -- che in un bring-up e' l'unico strumento diagnostico.
#
# Per riabilitare la rete: togliere "# CONFIG_NET is not set" qui e
# rimettere BR2_PACKAGE_IFUPDOWN_SCRIPTS nel defconfig. C'e' margine, 6.30
# contro 12.00 MiB, ma va riverificato: la verifica dimensioni di
# post-image.sh e' il guardrail.
# CONFIG_NET is not set
# CONFIG_FTRACE is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_I2C is not set
# CONFIG_PCI is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_IIO is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_REGULATOR is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_DMADEVICES is not set
# CONFIG_CRYPTO_HW is not set

# ---------------------------------------------------------------------------
# AGGIUNTO QUI (4/6): allineamento al percorso vendor
# ---------------------------------------------------------------------------
# Stessa scelta di linux.config: nessun package di questo albero installa
# moduli, e senza moduli non serve il supporto.
# CONFIG_MODULES is not set

# Utile in bring-up: dice a colpo d'occhio quale commit sta girando.
CONFIG_LOCALVERSION_AUTO=y

# ---------------------------------------------------------------------------
# AGGIUNTO QUI (5/6): quello che il primo boot ha rivelato
# ---------------------------------------------------------------------------
# Queste righe vengono dal dmesg del primo boot riuscito, non da un'analisi a
# priori: sono cose che si vedono solo con la board che parla.
#
# CMA: multi_v7_defconfig:1305 mette CONFIG_CMA_SIZE_MBYTES=64. Su una board
# da 128 MiB significa riservarne META' per il DMA contiguo:
#
#     cma: Reserved 64 MiB at 0x04000000
#     Memory: 48024K/129024K available (... 65536K cma-reserved ...)
#
# 48 MB utilizzabili su 128. E non serve a nulla: CMA lo vogliono DRM, V4L2 e
# MMC, che sono tutti spenti dalla sezione (3/6). Spegnendolo la RAM torna
# disponibile.
#
# Gli altri sono driver che il dmesg mostra ancora vivi nonostante il pruning
# delle piattaforme, perche' non sono gated su un ARCH_*: restano da
# multi_v7_defconfig e ognuno e' un probe in piu' senza un nodo nel DT che lo
# reclami.
#
#     Serial: AMBA PL011 UART driver
#     STMicroelectronics ASC driver initialized
#     SCSI subsystem initialized
#     libata version 3.00 loaded
#     squashfs: version 4.0
#     brd: module loaded / loop: module loaded
#     scmi_core: SCMI protocol bus registered
#     EDAC MC: Ver: 3.0.0
#
# La console e' 8250-dw, il rootfs e' un initramfs: niente di tutto questo ha
# un utente su questa board.
# CONFIG_CMA is not set
# CONFIG_SERIAL_AMBA_PL011 is not set
# CONFIG_SERIAL_ST_ASC is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_SQUASHFS is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_EDAC is not set

# ---------------------------------------------------------------------------
# AGGIUNTO QUI (6/6): la SPI NAND
# ---------------------------------------------------------------------------
# MTD e SPI erano spenti dalle sezioni (3/6) e (5/6) con la motivazione
# "niente storage in questo bring-up": ogni probe in piu' era un rischio
# prima che la console fosse dimostrata. Ora lo e', quindi quella cautela e'
# scaduta e si puo' descrivere il medium da cui la board boota davvero.
#
# Serve il nodo sfc nel DTS, che esiste dal commit ae43912e del repo kernel:
# il controller e' l'FSPI, descritto come "rockchip,sfc".
#
# Il punto non ovvio e' perche' quel compatible generico basti per un IP che
# il vendor tratta come diverso. Il driver mainline dichiara un solo
# compatible, "rockchip,sfc" (spi-rockchip-sfc.c:822-825), legge la versione
# dell'IP dal registro SFC_VER a runtime (riga 691) e NON rifiuta mai una
# versione che non conosce: la usa solo per adattare il comportamento
# (`>= SFC_VER_4`, `>= SFC_VER_8`). Quindi non c'e' nessuna tabella da
# estendere per il RK3506 - il nodo nel DTS e' tutto il lavoro.
#
# Confermato su hardware al boot #4:
#     spi-nand spi0.0: Winbond SPI NAND was found.
#     spi-nand spi0.0: 256 MiB, block size: 128 KiB, page size: 2048, OOB size: 128
# Da notare: il driver non stampa nulla quando il probe riesce (in
# spi-rockchip-sfc.c ci sono solo dev_err e dev_dbg, nessun dev_info), quindi
# l'assenza di una riga "rockchip-sfc" nel dmesg NON e' un fallimento: la
# prova e' l'esistenza di spi0.0.
#
# CONFIG_SPI_ROCKCHIP_SFC e' il driver; MTD_SPI_NAND traduce la flash in un
# MTD; MTD_CMDLINE_PARTS legge le partizioni da mtdparts= nella cmdline -
# quella scritta nella sezione (1/6), NON quella di U-Boot ne' il CMDLINE: di
# parameter.txt, per il motivo di mtd-id spiegato la'.
#
# UBI e UBIFS servono al defconfig con rootfs su flash. Non costano nulla
# alla variante initramfs, e in cambio le danno la possibilita' di
# ispezionare e riscrivere la NAND da RAM - che e' esattamente cio' che
# serve prima di metterci un rootfs. Il percorso vendor fa la stessa scelta:
# lyra_plus_initramfs_defconfig ha BR2_PACKAGE_MTD=y.
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_MEM=y
CONFIG_SPI_ROCKCHIP_SFC=y

# ---------------------------------------------------------------------------
# Come far parlare il kernel PRIMA di earlycon
# ---------------------------------------------------------------------------
# Tenuto commentato, non attivo. Serve quando la board si ferma dopo
# "Starting kernel ..." senza stampare niente: e' successo davvero, e senza
# questo blocco non c'e' modo di distinguere le cause fra loro.
#
# Perche' earlycon non basta: la finestra in cui il boot puo' morire in
# silenzio e' PRIMA che earlycon esista.
#
#   setup.c:1106   mdesc = setup_machine_fdt(atags_vaddr);
#   setup.c:1138   parse_early_param();          <- earlycon nasce qui
#
# e in quella finestra early_print() raggiunge una UART SOLO con DEBUG_LL
# (setup.c:368-370); altrimenti e' un printk in un ring buffer senza console,
# e dump_machine_table() finisce in "while (true);" (setup.c:756-757).
#
# Ancora piu' a monte: il decompressore stampa "Uncompressing Linux... done,
# booting the kernel." solo con DEBUG_LL. Quella riga e' lo spartiacque piu'
# utile che ci sia: se compare, la decompressione e' arrivata in fondo e il
# problema e' dopo; se non compare, il decompressore e' morto prima di
# decompress_kernel(), che e' esattamente il caso risolto dalla patch
# patches-mainline/linux/0001-dts-keep-linux-out-of-the-op-tee-region.patch.
#
# SHIFT=2 e WORD=y corrispondono a reg-shift = <2> e reg-io-width = <4> del
# nodo uart0 (rk3506.dtsi:150-151). VIRT e' un indirizzo libero fra le
# mappature statiche: debug_ll_io_init() ne mappa una pagina sola con
# iotable_init() (mm/mmu.c:1138-1149), quindi qualunque indirizzo non usato
# va bene. DEBUG_KERNEL, da cui DEBUG_LL dipende, e' gia' in
# multi_v7_defconfig:1307.
#
# ATTENZIONE: DEBUG_LL cabla UNA sola UART nel kernel e lo rende non
# portabile su altre board (lo dice il suo help in Kconfig.debug:119-122).
# Va acceso per diagnosticare e rispento subito dopo.
#
# CONFIG_DEBUG_LL=y
# CONFIG_DEBUG_LL_UART_8250=y
# CONFIG_DEBUG_UART_PHYS=0xff0a0000
# CONFIG_DEBUG_UART_VIRT=0xf00a0000
# CONFIG_DEBUG_UART_8250_SHIFT=2
# CONFIG_DEBUG_UART_8250_WORD=y
# CONFIG_EARLY_PRINTK=y
