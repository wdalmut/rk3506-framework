BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_19=y
BR2_GCC_VERSION_13_X=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_LYRA_PLUS_PATH)/patches $(BR2_EXTERNAL_LYRA_PLUS_PATH)/board/lyra-plus/patches"
BR2_TARGET_GENERIC_HOSTNAME="lyra-plus"
BR2_TARGET_GENERIC_ISSUE="Luckfox Lyra Plus (RK3506G2) - mainline 6.19 initramfs bring-up"
BR2_TARGET_GENERIC_ROOT_PASSWD="lyra"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LYRA_PLUS_PATH)/board/lyra-plus/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LYRA_PLUS_PATH)/board/lyra-plus/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_LYRA_PLUS_PATH)/board/lyra-plus/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/wdalmut/rk3506-kernel-upstream.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="c3a99014e11e7fe3a35860aadb16d7d4b5bb24d0"
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LYRA_PLUS_PATH)/board/lyra-plus/linux-mainline.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3506g-luckfox-lyra-plus"
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/wdalmut/rk3506-uboot.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="1625f78b6dcf9fe401d447da79132b7bc6804538"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rk3506_luckfox"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LYRA_PLUS_PATH)/board/lyra-plus/uboot.config"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_SPL=y
BR2_PACKAGE_HOST_RK_RESOURCE_TOOL=y
BR2_PACKAGE_HELLO_LYRA=y
